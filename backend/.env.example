# Copy to backend/.env and fill in. NEVER commit .env
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
PORT=3000
# Optional
# CLIENT_ORIGIN=https://your-frontend-domain   (only if frontend is hosted on a different origin)
# PYTHON_BIN=python3
# START_ML=false                                (skip starting the Flask/YOLO server)

# Google login (Google Cloud Console → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=83721655421-97tjbt0f4i5leu1kgpv1a400silskius.apps.googleusercontent.com
